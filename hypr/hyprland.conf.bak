

# This config is a STUB! This should never be generated.
# Use the default lua config from https://github.com/hyprwm/Hyprland/blob/main/example/hyprland.lua

autogenerated = 0


$mainMod = SUPER
$terminal = kitty
$fileManager = dolphin
$menu = hyprlauncher

# Регулировка громкости плавно (при зажатии) и выключение звука (Mute)
binde = , XF86AudioRaiseVolume, exec, wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
binde = , XF86AudioLowerVolume, exec, wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bind  = , XF86AudioMute, exec, wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
binde = , F5, exec, wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
binde = , F6, exec, wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+



#основные приложения
bind = $mainMod, Q, exec, $terminal
bind = $mainMod, C, killactive,
bind = $mainMod, M, exec, command -v hyprshutdown >/dev/null 2>&1 && hyprshutdown || hyprctl dispatch exit
bind = $mainMod, E, exec, $fileManager
bind = $mainMod, V, togglefloating,
bind = $mainMod, R, exec, $menu
bind = $mainMod, D, exec, rofi -show drun -show-icons
bind = $mainMod, B, exec, killall -SIGUSR1 waybar

#управления окнами
bind = $mainMod SHIFT, left, movewindow, l
bind = $mainMod SHIFT, right, movewindow, r
bind = $mainMod SHIFT, up, movewindow, u
bind = $mainMod SHIFT, down, movewindow, d
bindm = $mainMod, mouse:272, movewindow
bindm = $mainMod, mouse:273, resizewindow
# раскладка и прочие приятности 
source = ~/.config/hypr/RU
#Waybar
exec-once = waybar
exec-once = nm-applet --indicator

# Переключение на рабочие столы (1-5)
bind = $mainMod, 1, workspace, 1
bind = $mainMod, 2, workspace, 2
bind = $mainMod, 3, workspace, 3
bind = $mainMod, 4, workspace, 4
bind = $mainMod, 5, workspace, 5
# Перемещение активного окна на выбранный рабочий стол
bind = $mainMod SHIFT, 1, movetoworkspace, 1
bind = $mainMod SHIFT, 2, movetoworkspace, 2
bind = $mainMod SHIFT, 3, movetoworkspace, 3
bind = $mainMod SHIFT, 4, movetoworkspace, 4
bind = $mainMod SHIFT, 5, movetoworkspace, 5

# Переключение на следующий / предыдущий стол стрелками или Ctrl+Alt
bind = $mainMod CTRL, right, workspace, e+1
bind = $mainMod CTRL, left, workspace, e-1
# Закрепить столы 1, 2 и 3 за монитором DP-1 (имя монитора можно узнать командой hyprctl monitors)
workspace = 1, monitor:DP-1, persistent:true
workspace = 2, monitor:DP-1, persistent:true
workspace = 3, monitor:DP-1, persistent:true
# --- БУФЕР ОБМЕНА И ИСТОРИЯ (ROFI) ---
exec-once = wl-paste --type text --watch cliphist store
exec-once = wl-paste --type image --watch cliphist store

bind = SUPER, U, exec, cliphist list | rofi -dmenu -display-columns 2 | cliphist decode | wl-copy

# --- СКРИНШОТЫ ---
# Выделить область -> открыть в редакторе swappy
bind = SUPER SHIFT, S, exec, grim -g "$(slurp)" - | swappy -f -

# Весь экран -> сохранить в папку ~/Pictures/Screenshots
bind = SUPER, P, exec, mkdir -p ~/Pictures/Screenshots && grim ~/Pictures/Screenshots/$(date +'%Y-%m-%d_%H-%M-%S').png


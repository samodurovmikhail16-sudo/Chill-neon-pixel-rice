* {
    bg:          #12131a;
    bg-alt:      #1a1c26;
    fg:          #d8dee9;
    neon-pink:   #d16d9e;
    neon-cyan:   #64b5c6;
    muted:       #565f78;
    
    background-color: transparent;
    text-color: @fg;
    font: "DepartureMono Nerd Font 11";
}

window {
    width: 480px;
    background-color: @bg;
    border: 3px solid;
    border-color: @neon-pink;
    border-radius: 0px;
    padding: 4px;
}

mainbox {
    border: 2px solid;
    border-color: @neon-cyan;
    padding: 14px;
    spacing: 14px;
}

inputbar {
    background-color: @bg-alt;
    border: 2px solid;
    border-color: @neon-cyan;
    padding: 8px 12px;
    children: [prompt, entry];
}

prompt {
    text-color: @neon-pink;
    margin: 0px 10px 0px 0px;
}

entry {
    text-color: @neon-cyan;
    placeholder: "SEARCH...";
    placeholder-color: @muted;
}

listview {
    lines: 8;
    columns: 1;
    scrollbar: false;
    spacing: 6px;
}

element {
    padding: 6px 10px;
    border: 1px solid;
    border-color: transparent;
}

element selected {
    background-color: @neon-pink;
    text-color: #0e0f14;
    border: 1px solid;
    border-color: @neon-cyan;
}


